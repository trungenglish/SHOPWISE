    {
      "id": "claim_9db017ed1aa14c3ca8ee454c51ca3a3d",
      "statement": "Resume-session service tests lock down the token lifecycle: valid tokens resume sessions, consumed tokens return `ErrTokenConsumed`, generating a newer token revokes older unconsumed tokens and causes `ErrTokenRevoked`, invalid signatures return `ErrTokenInvalid`, different context hashes do not hard-block resume, expired tokens return `ErrTokenExpired`, and inactivity notifications require an authenticated session owner with a verified notification identity.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/resume_session/usecase/service_test.go#L106-L175",
          "version": "repo-lines-v1:sha256:c571613370a1f0a908719b609c17bafab6e1b769d0c2fc6a2ec1eb6df47539db:"
