    {
      "id": "claim_4e18208d0fa144459915ddf609057319",
      "statement": "The backend composition root registers health plus `/api/v1` domain routes for identity, users, checkout, orders, files, products, accessories, stores, decision-memory sessions, resume-session endpoints, promotions, and admin, all on a Gin engine configured with recovery, request logging, CORS, centralized error handling, and debug-only Swagger.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/bootstrap/bootstrap.go#L141-L178",
          "version": "repo-lines-v1:sha256:262243d4e273336085c68905108608a6c840baa3411377f8fe5fb066af2e3aea:"
