    {
      "id": "claim_aaf9219f8cd44792a31a1d6ddf4c7cf8",
      "statement": "For streaming chat, the Go backend proxies the AI runtime's SSE stream to the client but still interprets the stream, accumulates token and decision state, and persists the completed assistant envelope when the `done` event arrives, emitting an SSE error event if saving fails.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/decision_memory/handler/chat.go#L192-L309",
