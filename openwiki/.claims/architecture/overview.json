        },
        {
          "resource": "repo://services/ai-runtime/src/models/schemas.py#L69-L103",
          "version": "repo-lines-v1:sha256:212aaf319af82d7ea40d49335561a0e99aec4687d8d2ce692d90f1df9540d987:"
        }
      ]
    },
