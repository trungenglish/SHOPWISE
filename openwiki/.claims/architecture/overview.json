    {
      "id": "claim_addfa89b68544f9abc7d9a49e7196bcf",
      "statement": "The Python AI runtime is a separate FastAPI service that logs per-request latency with an `X-Process-Time` header, exposes `/health`, mounts its chat router under `/api/v1`, and returns structured `AIErrorState` payloads for unhandled exceptions.",
      "evidence": [
        {
          "resource": "repo://services/ai-runtime/src/main.py#L1-L61",
          "version": "repo-lines-v1:sha256:c7bd5a5c43cebb2fe062c16edb49b982172eded437ae6d9934b4d7994207e5cd:"
        }
      ]
    },
    {
      "id": "claim_d8290be17d4c4a36b70ea54734c2a9ff",
      "statement": "The AI runtime is stateless with respect to durable session ownership: its chat API requires callers to send `session_id` and prior messages, its settings point back to the Go backend via `backend_url`, and its tool layer fetches catalog and offer-comparison data from backend HTTP endpoints instead of direct database access.",
      "evidence": [
        {
          "resource": "repo://services/ai-runtime/src/api/chat.py#L21-L30",
