    {
      "id": "claim_ad4e2e6b775843b3935af8daeb15039c",
      "statement": "The backend is the system of record for conversation state: the decision-memory chat handler verifies session ownership, stores the user message, reloads session history, derives allowed comparison product IDs from stored assistant reasoning envelopes, forwards a normalized payload to the AI runtime, and persists the assistant response back into storage.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/decision_memory/handler/chat.go#L40-L190",
          "version": "repo-lines-v1:sha256:200e3b29a72452a4f82036f48966625580ece8c10561e343ae0f799b1fa48343:"
