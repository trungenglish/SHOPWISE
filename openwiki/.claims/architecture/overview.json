    {
      "id": "claim_c9d1b2601cd44acea9db6f325c2ac8bc",
      "statement": "The AI runtime's chat endpoint builds a LangGraph workflow that first loads catalog and allowed offer-comparison data from backend APIs, then requests a JSON-schema-constrained model response, validates it into an `AgentDraft`, hydrates it into an `AgentResponse`, and retries the LLM step up to two times when validation fails.",
      "evidence": [
        {
          "resource": "repo://services/ai-runtime/src/api/chat.py#L95-L117",
