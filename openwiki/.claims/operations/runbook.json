    {
      "id": "claim_dd25851dacc64307b142ef1ac3e7dd54",
      "statement": "The backend has two different seed paths: `bootstrap.Migrate()` runs migrations for users, identity, orders, decision memory, accessories catalog, resume session, and promotions; `bootstrap.Seed()` only ensures startup metadata; and the package `seed` script instead runs `cmd/seed`, which reads `cmd/seed/products/seed_products_demo.json` and upserts demo products with normalized VND pricing.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/cmd/seed/main.go#L20-L122",
          "version": "repo-lines-v1:sha256:287bac9e338f7aadfd4a2b1f6e1c8d85f7cd41318be01afc37a04669b1be208b:"
