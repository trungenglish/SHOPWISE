    {
      "id": "claim_92900de9abb141a0b18217d0527ff225",
      "statement": "The main backend binary in `cmd/retail` supports two operational flags before normal server startup: `-migrate` runs `bootstrap.Migrate()` and `-seed` runs `bootstrap.Seed()`.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/cmd/retail/main.go#L17-L39",
