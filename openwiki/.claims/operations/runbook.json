      "id": "claim_f4cdbb13a2764e28a9c4fc3f1d4bd215",
      "statement": "Backend config loads `.env` first and falls back to `.env.example` when database or Redis settings are absent, requires `DATABASE_URL`, `REDIS_URL`, and `JWT_SECRET`, defaults `AI_RUNTIME_URL` to `http://localhost:8000`, and parses `ALLOWED_ORIGINS` as a comma-separated list.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/.env.example#L1-L23",
