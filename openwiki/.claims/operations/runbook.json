    {
      "id": "claim_41f2de517e434c5b8f23dd9e2e918731",
      "statement": "The AI runtime is a FastAPI service started from `services/ai-runtime` with `uv run uvicorn src.main:app --reload --port 8000`, requires Python 3.11+ and `uv`, and depends on FastAPI, LangGraph, OpenAI, SSE support, and test tooling declared in `pyproject.toml`.",
      "evidence": [
        {
          "resource": "repo://services/ai-runtime/README.md#L22-L37",
          "version": "repo-lines-v1:sha256:03087c1b8c83d28dfe50d6f584adc31e5e1b91bde4dc7c98666fe215b80442f2:"
