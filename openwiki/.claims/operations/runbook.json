    {
      "id": "claim_b9b7b92e8f884594a8869ea39b99c737",
      "statement": "The backend server entrypoint in `services/main-backend/cmd/retail/main.go` supports normal startup plus `-migrate` and `-seed` flags, and bootstrap startup loads config, connects database and Redis, creates a Redis-backed job client, wires the domain handlers and routes, and only then starts the HTTP server.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/cmd/retail/main.go#L17-L38",
          "version": "repo-lines-v1:sha256:d4246b548c87eb80c39b10515b5dd461dc0d7a252579b6084e42de62f2dd9d2a:"
