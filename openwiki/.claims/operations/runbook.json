    {
      "id": "claim_af2d7ea2eeba4f3e8344ecf3565f09c6",
      "statement": "The backend config loader reads `.env` first and, when `DATABASE_URL` or `REDIS_URL` are still missing, falls back to `.env.example`; it defaults `GIN_MODE` to `debug`, `PORT` to `18080`, `WEB_APP_URL` to `http://localhost:3001`, and `AI_RUNTIME_URL` to `http://localhost:8000`, while treating `DATABASE_URL`, `REDIS_URL`, and `JWT_SECRET` as required.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/platform/config/config.go#L50-L125",
          "version": "repo-lines-v1:sha256:6306802863c0c37b7dce695c29cc69526f88f171264a2e32cc8ee4d465c399c7:"
        }
      ]
