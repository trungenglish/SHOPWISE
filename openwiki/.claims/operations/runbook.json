    },
    {
      "id": "claim_04e9d64d3d4741a2ad8c75b82eaa9e60",
      "statement": "The mobile app’s local backend target is configured through `EXPO_PUBLIC_SERVER_URL`, and the shipped example points it at `http://localhost:18080`.",
