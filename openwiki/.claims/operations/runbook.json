  "claims": [
    {
      "id": "claim_a0b1ba7c56724a0eb774efb742629ea6",
      "statement": "The monorepo root uses Turbo-driven pnpm scripts for development and builds, including `pnpm dev`, `pnpm build`, `pnpm check-types`, `pnpm dev:web`, `pnpm dev:mobile`, `pnpm dev:server`, and `pnpm dev:server:docker`, and Turbo marks `dev` as persistent and non-cached while `build` depends on upstream builds and treats `.env*` files as inputs.",
      "evidence": [
        {
          "resource": "repo://package.json#L2-L15",
          "version": "repo-lines-v1:sha256:660df5957f14b780499b857f0e65198cb63f28527ea93fc48f1561898d5a2545:"
        },
        {
          "resource": "repo://turbo.json#L4-L19",
          "version": "repo-lines-v1:sha256:45d59b03ae6b01ace9787d2c6b41880981bea94b2583b80734f030ecf922e461:"
        }
      ]
    },
    {
      "id": "claim_0e77ecdd4ea6479ab474486f957db594",
      "statement": "The main backend's local dependency stack is defined in `services/main-backend/docker-compose.yml`, where Postgres is exposed on `127.0.0.1:5432`, Redis on `127.0.0.1:6379`, and the containerized server is published on host port `18080` while waiting for healthy Postgres and Redis; `infra/docker-compose.yml` is currently empty.",
      "evidence": [
        {
          "resource": "repo://infra/docker-compose.yml",
          "version": "repo-file-v1:sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
