        }
      ]
    },
    {
      "id": "claim_f12570a1038f4f488f8502f020966bf5",
      "statement": "AI runtime settings are loaded from `services/ai-runtime/.env`; they require `OPENAI_API_KEY`, default `model` to `gpt-5.4-mini`, default `backend_url` to `http://localhost:18080`, and because settings are instantiated at import time with no default for the API key, the runtime will fail to boot until that key is present.",
      "evidence": [
        {
          "resource": "repo://services/ai-runtime/src/core/config.py#L7-L28",
          "version": "repo-lines-v1:sha256:483935c6104a2d87f6cfdd90d861d64f00b3d3c0f0ee647546924922ccff6295:"
