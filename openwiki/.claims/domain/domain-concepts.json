          "version": "repo-lines-v1:sha256:7ad52186192496e01b7f28af08e1369e40e4c342fc8a8c8d8487f5e2d94e5026:"
        }
      ]
    },
    {
      "id": "claim_4864a06d34124c7cb21adb38c8b46b02",
      "statement": "The dynamic AI UI contract is a whitelisted, schema-validated envelope: version `1.0` envelopes carry turn, revision, conversation state, UI state, and `ui_operations`, component types and action names are enumerated up front, and component props reject dangerous property names such as `html`, `script`, `style`, and `dangerouslySetInnerHTML`.",
      "evidence": [
        {
          "resource": "repo://packages/protocols/src/index.ts#L1-L111",
          "version": "repo-lines-v1:sha256:0c871f3522ac7c41d1f797be5f1c9ac2c09e7e4bab5cf36739123a833f7c489a:"
        },
        {
