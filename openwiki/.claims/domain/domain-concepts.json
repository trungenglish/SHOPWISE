    {
      "id": "claim_e4b729cb6f3d4d62a3db9f5c38c843ad",
      "statement": "Decision sessions persist both conversational history and machine-readable assistant artifacts: a `DecisionSession` owns session identity, ownership, parent-session linkage, timestamps, and ordered `Messages`, while each `SessionMessage` can carry `ReasoningGraph` and `PinnedProducts` data in addition to text content.",
      "evidence": [
        {
          "resource": "repo://services/main-backend/internal/decision_memory/domain/domain.go#L15-L35",
          "version": "repo-lines-v1:sha256:19f2abcbc2b30fc37cc2fde8c1e0a9284d932359c546e445da71ca7d2a5587c3:"
        },
        {
