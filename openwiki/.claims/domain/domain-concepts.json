    {
      "id": "claim_03d9c7c7204643a79fc8f7e9b2accb56",
      "statement": "Resuming a session requires a verified JWT plus matching stored token metadata, and the backend rejects revoked, consumed, expired, or mismatched tokens; successful resume marks the token consumed, while an issued-versus-consumed context mismatch is logged as an audit-risk signal rather than blocked.",
