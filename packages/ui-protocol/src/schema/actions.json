{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopwise.local/schema/actions.json",
  "title": "Commerce Actions",
  "description": "Schemas for Commerce Actions",
  "$defs": {
    "AddToComparisonPayload": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" }
      },
      "required": ["productId"]
    },
    "RemoveProductPayload": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" }
      },
      "required": ["productId"]
    },
    "SaveDecisionPayload": {
      "type": "object",
      "properties": {
        "decisionId": { "type": "string" },
        "productId": { "type": "string" }
      },
      "required": ["decisionId", "productId"]
    },
    "ResumeConversationPayload": {
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" }
      },
      "required": ["conversationId"]
    },
    "CheckoutReadinessPayload": {
      "type": "object",
      "properties": {
        "cartId": { "type": "string" },
        "ready": { "type": "boolean" }
      },
      "required": ["ready"]
    }
  },
  "type": "object"
}
