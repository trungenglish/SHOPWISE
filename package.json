{
  "name": "shopwise",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:mobile": "turbo -F mobile dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:server:docker": "turbo -F server dev:docker",
    "deploy": "turbo -F @shopwise/infra deploy",
    "destroy": "turbo -F @shopwise/infra destroy",
