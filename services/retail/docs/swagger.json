                            "$ref": "#/definitions/internal_administration_handler.statusResponse"
                        }
                    }
                }
            }
        },
        "/files/status": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Files module status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_files_handler.statusResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "platform"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
