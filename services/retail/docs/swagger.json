{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Modular monolith REST API for React web and native clients.",
        "title": "Boilerplate Server API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:18080",
    "basePath": "/api/v1",
    "paths": {
        "/admin/status": {
            "get": {
