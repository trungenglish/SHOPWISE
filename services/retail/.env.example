PORT=18080
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3001
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=debug
APP_NAME=server

# Auth (required for identity endpoints)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Google OAuth (optional for local dev without Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18080/api/v1/identity/google/callback
WEB_APP_URL=http://localhost:3001

# LLM (optional until advisor epic)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# SMTP (optional; use Mailhog in docker-compose for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopwise.local

# Document uploads (ownership epic)
STORAGE_PATH=./storage

